# Dots Catering — environment configuration
# Copy to .env (or set these as deployment variables) and fill in real values.
# The site runs fine without the optional keys; they only unlock extra features.

# ---------------------------------------------------------------------------
# Staff back office (/admin) — REQUIRED
# ---------------------------------------------------------------------------
# Choose a strong password, e.g. "1Juicy!Plate@2026".
ADMIN_PASSWORD=change-me

# Random hex used to sign the staff session cookie. Generate with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SIGNED_SECRET=change-me

# ---------------------------------------------------------------------------
# USDA Market News API (live grocery prices on the public site) — optional
# ---------------------------------------------------------------------------
# Free key at https://mymarketnews.ams.usda.gov (My Profile)
# USDA_API_KEY=
# USDA_REPORT_SLUG=

# ---------------------------------------------------------------------------
# Stripe deposits (bookings "Pay 20% Deposit" button) — optional
# ---------------------------------------------------------------------------
# 1) Create a Stripe account: https://dashboard.stripe.com/
# 2) Grab API keys:  Developers -> API keys.
#    - Test keys start with sk_test_ ; live keys start with sk_live_.
#    - Prefer a restricted key (rk_) limited to Checkout Sessions read/write.
# 3) For local development, forward webhooks to your server:
#      stripe listen --forward-to localhost:8765/webhook
#    then paste the whsec_... secret it prints below.
# 4) On your deployed server, add an HTTPS endpoint and configure the webhook
#    in the Stripe dashboard (Events: checkout.session.completed,
#    checkout.session.async_payment_succeeded) with the whsec_ secret.
#
# STRIPE_SECRET_KEY=sk_test_XXXX
# STRIPE_WEBHOOK_SECRET=whsec_XXXX
# Deposit as a fraction of the booking price (0.20 = 20%).
# DEPOSIT_RATIO=0.20

# ---------------------------------------------------------------------------
# Weather / service area — optional (defaults to Virginia Beach, VA)
# ---------------------------------------------------------------------------
# WEATHER_LOCATION=Virginia Beach, VA
# WEATHER_LAT=
# WEATHER_LON=