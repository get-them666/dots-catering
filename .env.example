# Copy this file to .env and fill in what you have. Nothing here is required to run.

# Staff password for the back office (/admin).
# If unset, a temporary one is printed to the console at server start.
ADMIN_PASSWORD=change-me
# Set a stable secret so staff sessions survive restarts.
# SIGNED_SECRET=change-me-too

# USDA Market News API key — free at https://mymarketnews.ams.usda.gov (My Profile)
# Without it, the price feed gracefully falls back to sample/manual data.
# USDA_API_KEY=
# USDA_REPORT_SLUG=

# Stripe — live keys are 'sk_live_...'. Site runs fine without them.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# DEPOSIT_RATIO=0.20

# Weather / service area — defaults to Virginia Beach, VA (your 120-mile radius).
# Override the anchor with a city name, or pin exact coordinates.
# WEATHER_LOCATION=Virginia Beach, VA
# WEATHER_LAT=
# WEATHER_LON=